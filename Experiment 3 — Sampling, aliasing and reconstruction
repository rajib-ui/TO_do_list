            "==========================================\n",
            "Nyquist rate = 60 Hz\n",
            "\n",
            "fs = 100 Hz:\n",
            "  fs > 2fmax\n",
            "  → No aliasing\n",
            "  → Signal should be reconstructed accurately\n",
            "\n",
            "fs = 60 Hz:\n",
            "  fs = 2fmax\n",
            "  → Nyquist boundary\n",
            "  → Ideal reconstruction is theoretically possible\n",
            "\n",
            "fs = 40 Hz:\n",
            "  fs < 2fmax\n",
            "  → Aliasing occurs\n",
