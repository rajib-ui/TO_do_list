      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 3: SAMPLING, ALIASING AND RECONSTRUCTION\n",
        "# ============================================================\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Two-tone signal\n",
        "# x(t) = sin(2*pi*f1*t) + 0.5*sin(2*pi*f2*t)\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "f1 = 10       # First frequency in Hz\n",
        "f2 = 30       # Second frequency in Hz\n",
        "A1 = 1        # Amplitude of first tone\n",
        "A2 = 0.5      # Amplitude of second tone\n",
        "\n",
        "fmax = max(f1, f2)\n",
        "nyquist_rate = 2 * fmax\n",
        "\n",
        "print(\"==========================================\")\n",
        "print(\"SAMPLING, ALIASING AND RECONSTRUCTION\")\n",
        "print(\"==========================================\")\n",
        "print(\"f1 =\", f1, \"Hz\")\n",
        "print(\"f2 =\", f2, \"Hz\")\n",
        "print(\"Maximum frequency =\", fmax, \"Hz\")\n",
        "print(\"Nyquist rate =\", nyquist_rate, \"Hz\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. IMPORTANT:\n",
        "# Physical sampling rate and plotting resolution are different\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "duration = 1.0\n",
        "\n",
        "# This is ONLY for drawing a smooth continuous-time waveform.\n",
        "# It is NOT the physical sampling frequency.\n",
        "plot_fs = 5000\n",
        "\n",
        "t = np.arange(0, duration, 1 / plot_fs)\n",
        "\n",
        "# Reference continuous-time signal\n",
        "x = (\n",
        "    A1 * np.sin(2 * np.pi * f1 * t)\n",
        "    + A2 * np.sin(2 * np.pi * f2 * t)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Sampling frequencies\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "sampling_rates = [100, 60, 40]\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Sinc interpolation function\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def sinc_reconstruction(t, ts, samples):\n",
        "    \"\"\"\n",
        "    Reconstruct signal using sinc interpolation:\n",
        "\n",
        "    x_r(t) = sum x[n] sinc((t-nTs)/Ts)\n",
        "    \"\"\"\n",
        "\n",
        "    Ts = 1 / (1 / (ts[1] - ts[0]))\n",
        "\n",
        "    # Actual sampling period\n",
        "    Ts = ts[1] - ts[0]\n",
        "\n",
        "    reconstructed = np.zeros(len(t))\n",
        "\n",
        "    # Process in chunks to avoid excessive memory use\n",
        "    chunk_size = 250\n",
        "\n",
        "    for start in range(0, len(t), chunk_size):\n",
        "\n",
        "        end = min(start + chunk_size, len(t))\n",
        "\n",
        "        t_chunk = t[start:end]\n",
        "\n",
        "        # sinc((t - nTs)/Ts)\n",
        "        sinc_matrix = np.sinc(\n",
        "            (t_chunk[:, None] - ts[None, :]) / Ts\n",
        "        )\n",
        "\n",
        "        reconstructed[start:end] = sinc_matrix @ samples\n",
        "\n",
        "    return reconstructed\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Magnitude spectrum function\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def spectrum(signal, fs):\n",
        "\n",
        "    N = len(signal)\n",
        "\n",
        "    # FFT\n",
        "    X = np.fft.rfft(signal)\n",
        "\n",
        "    # Frequency axis\n",
        "    f = np.fft.rfftfreq(N, 1 / fs)\n",
        "\n",
        "    # Magnitude\n",
        "    magnitude = (2 / N) * np.abs(X)\n",
        "\n",
        "    return f, magnitude\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. MANDATORY ALIAS CALCULATION\n",
        "# ============================================================\n",
        "\n",
        "fs_under = 40\n",
        "\n",
        "# 30 Hz component sampled at 40 Hz\n",
        "k = round(f2 / fs_under)\n",
        "\n",
        "alias_frequency = abs(f2 - k * fs_under)\n",
        "\n",
        "# If required, fold into [0, fs/2]\n",
        "if alias_frequency > fs_under / 2:\n",
        "    alias_frequency = fs_under - alias_frequency\n",
        "\n",
        "print(\"\\n------------------------------------------\")\n",
        "print(\"MANDATORY ALIAS CALCULATION\")\n",
        "print(\"------------------------------------------\")\n",
        "\n",
        "print(\"Undersampling frequency =\", fs_under, \"Hz\")\n",
        "print(\"Original frequency =\", f2, \"Hz\")\n",
        "print()\n",
        "print(\"f_alias = |f - k*fs|\")\n",
        "print(\n",
        "    \"       = |{} - {}*{}|\".format(\n",
        "        f2, k, fs_under\n",
        "    )\n",
        ")\n",
        "print(\"       =\", alias_frequency, \"Hz\")\n",
        "\n",
        "print()\n",
        "print(\n",
        "    \"Therefore, the 30 Hz component aliases to\",\n",
        "    alias_frequency,\n",
        "    \"Hz.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. SIMULATE ALL THREE CASES\n",
        "# ============================================================\n",
        "\n",
        "for fs in sampling_rates:\n",
        "\n",
        "    print(\"\\n==========================================\")\n",
        "    print(\"Sampling frequency =\", fs, \"Hz\")\n",
        "    print(\"==========================================\")\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Physical sampling\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    Ts = 1 / fs\n",
        "\n",
        "    ts = np.arange(0, duration, Ts)\n",
        "\n",
        "    # Sample the original continuous-time signal\n",
        "    samples = (\n",
        "        A1 * np.sin(2 * np.pi * f1 * ts)\n",
        "        + A2 * np.sin(2 * np.pi * f2 * ts)\n",
        "    )\n",
        "\n",
        "    print(\"Number of physical samples =\", len(samples))\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Sinc reconstruction\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    reconstructed = sinc_reconstruction(\n",
        "        t,\n",
        "        ts,\n",
        "        samples\n",
        "    )\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Reconstruction error\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    error = x - reconstructed\n",
        "\n",
        "    rmse = np.sqrt(\n",
        "        np.mean(error ** 2)\n",
        "    )\n",
        "\n",
        "    print(\"RMSE =\", rmse)\n",
        "\n",
        "    # ========================================================\n",
        "    # FIGURE\n",
        "    # ========================================================\n",
        "\n",
        "    fig, axes = plt.subplots(\n",
        "        2,\n",
        "        2,\n",
        "        figsize=(14, 9)\n",
        "    )\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Plot 1: Reference and sampled signal\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    time_limit = 0.25\n",
        "\n",
        "    mask = t <= time_limit\n",
        "    sample_mask = ts <= time_limit\n",
        "\n",
        "    axes[0, 0].plot(\n",
        "        t[mask],\n",
        "        x[mask],\n",
        "        label=\"Original signal\"\n",
        "    )\n",
        "\n",
        "    axes[0, 0].stem(\n",
        "        ts[sample_mask],\n",
        "        samples[sample_mask],\n",
        "        linefmt=\"C1-\",\n",
        "        markerfmt=\"C1o\",\n",
        "        basefmt=\" \",\n",
        "        label=\"Samples\"\n",
        "    )\n",
        "\n",
        "    axes[0, 0].set_title(\n",
        "        f\"Sampling: fs = {fs} Hz\"\n",
        "    )\n",
        "\n",
        "    axes[0, 0].set_xlabel(\"Time (s)\")\n",
        "    axes[0, 0].set_ylabel(\"Amplitude\")\n",
        "    axes[0, 0].grid()\n",
        "    axes[0, 0].legend()\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Plot 2: Sinc reconstruction\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    axes[0, 1].plot(\n",
        "        t[mask],\n",
        "        x[mask],\n",
        "        label=\"Original signal\"\n",
        "    )\n",
        "\n",
        "    axes[0, 1].plot(\n",
        "        t[mask],\n",
        "        reconstructed[mask],\n",
        "        \"--\",\n",
        "        label=\"Sinc reconstruction\"\n",
        "    )\n",
        "\n",
        "    axes[0, 1].set_title(\n",
        "        f\"Sinc Reconstruction: fs = {fs} Hz\"\n",
        "    )\n",
        "\n",
        "    axes[0, 1].set_xlabel(\"Time (s)\")\n",
        "    axes[0, 1].set_ylabel(\"Amplitude\")\n",
        "    axes[0, 1].grid()\n",
        "    axes[0, 1].legend()\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Plot 3: Magnitude spectrum\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    f_original, X_original = spectrum(\n",
        "        x,\n",
        "        plot_fs\n",
        "    )\n",
        "\n",
        "    f_reconstructed, X_reconstructed = spectrum(\n",
        "        reconstructed,\n",
        "        plot_fs\n",
        "    )\n",
        "\n",
        "    frequency_limit = 80\n",
        "\n",
        "    freq_mask = f_original <= frequency_limit\n",
        "\n",
        "    axes[1, 0].plot(\n",
        "        f_original[freq_mask],\n",
        "        X_original[freq_mask],\n",
        "        label=\"Original\"\n",
        "    )\n",
        "\n",
        "    axes[1, 0].plot(\n",
        "        f_reconstructed[freq_mask],\n",
        "        X_reconstructed[freq_mask],\n",
        "        \"--\",\n",
        "        label=\"Reconstructed\"\n",
        "    )\n",
        "\n",
        "    # Nyquist frequency\n",
        "    axes[1, 0].axvline(\n",
        "        fs / 2,\n",
        "        linestyle=\":\",\n",
        "        label=f\"Nyquist = {fs/2:g} Hz\"\n",
        "    )\n",
        "\n",
        "    axes[1, 0].set_title(\n",
        "        f\"Magnitude Spectrum: fs = {fs} Hz\"\n",
        "    )\n",
        "\n",
        "    axes[1, 0].set_xlabel(\"Frequency (Hz)\")\n",
        "    axes[1, 0].set_ylabel(\"Magnitude\")\n",
        "    axes[1, 0].set_xlim(0, frequency_limit)\n",
        "    axes[1, 0].grid()\n",
        "    axes[1, 0].legend()\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Plot 4: Reconstruction error\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    axes[1, 1].plot(\n",
        "        t[mask],\n",
        "        error[mask]\n",
        "    )\n",
        "\n",
        "    axes[1, 1].axhline(\n",
        "        0,\n",
        "        linestyle=\"--\"\n",
        "    )\n",
        "\n",
        "    axes[1, 1].set_title(\n",
        "        f\"Reconstruction Error: fs = {fs} Hz\\n\"\n",
        "        f\"RMSE = {rmse:.4f}\"\n",
        "    )\n",
        "\n",
        "    axes[1, 1].set_xlabel(\"Time (s)\")\n",
        "    axes[1, 1].set_ylabel(\"Error\")\n",
        "    axes[1, 1].grid()\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Overall figure title\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if fs > nyquist_rate:\n",
        "\n",
        "        case = \"ABOVE NYQUIST — No aliasing\"\n",
        "\n",
        "    elif fs == nyquist_rate:\n",
        "\n",
        "        case = \"AT NYQUIST RATE\"\n",
        "\n",
        "    else:\n",
        "\n",
        "        case = \"BELOW NYQUIST — Aliasing\"\n",
        "\n",
        "    fig.suptitle(\n",
        "        f\"{case} | Physical Sampling Rate = {fs} Hz\",\n",
        "        fontsize=16\n",
        "    )\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. FINAL THEORY SUMMARY\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\\n==========================================\")\n",
        "print(\"THEORETICAL EXPECTATION\")\n",
        "print(\"==========================================\")\n",
        "\n",
        "print(\n",
        "    f\"Nyquist rate = {nyquist_rate} Hz\"\n",
        ")\n",
        "\n",
        "print()\n",
        "print(\"fs = 100 Hz:\")\n",
        "print(\"  fs > 2fmax\")\n",
        "print(\"  → No aliasing\")\n",
        "print(\"  → Signal should be reconstructed accurately\")\n",
        "\n",
        "print()\n",
        "print(\"fs = 60 Hz:\")\n",
        "print(\"  fs = 2fmax\")\n",
        "print(\"  → Nyquist boundary\")\n",
        "print(\"  → Ideal reconstruction is theoretically possible\")\n",
        "\n",
        "print()\n",
        "print(\"fs = 40 Hz:\")\n",
        "print(\"  fs < 2fmax\")\n",
        "print(\"  → Aliasing occurs\")\n",
        "print(\n",
        "    f\"  → {f2} Hz component aliases to \"\n",
        "    f\"{alias_frequency} Hz\"\n",
        ")"
      ]
    }
